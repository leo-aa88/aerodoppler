# AeroDoppler configuration (all optional; see src/aerodoppler/config.py)
AERODOPPLER_DATA_DIR=./data
AERODOPPLER_HOST=127.0.0.1
AERODOPPLER_PORT=8000
AERODOPPLER_OFFLINE=false
AERODOPPLER_MAX_UPLOAD_MB=512
AERODOPPLER_MAX_AUDIO_DURATION_S=7200
AERODOPPLER_MAX_CONCURRENT_JOBS=2
AERODOPPLER_SPEED_OF_SOUND_TEMP_C=20
AERODOPPLER_ADSB_GAP_SPLIT_S=30
AERODOPPLER_ADSB_BBOX_MARGIN_KM=15
