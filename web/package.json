{
  "name": "aerodoppler-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-map-worker": "node -e \"require('fs').copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-worker.mjs'), 'public/maplibre-gl-worker.mjs')\"",
    "predev": "npm run copy-map-worker",
    "dev": "next dev -p 3000",
    "prebuild": "npm run copy-map-worker",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "plotly.js-dist-min": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
